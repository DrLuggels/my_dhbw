-- Cached exercises for offline learning
CREATE TABLE cached_exercises (
    id INTEGER NOT NULL PRIMARY KEY,
    entity_id INTEGER NOT NULL,
    question TEXT NOT NULL,
    exercise_type TEXT NOT NULL,
    difficulty TEXT NOT NULL,
    bloom_level INTEGER NOT NULL,
    options_json TEXT,
    correct_answer TEXT,
    explanation TEXT,
    cached_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Offline answer queue
CREATE TABLE pending_answers (
    id INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT,
    exercise_id INTEGER NOT NULL,
    user_answer TEXT NOT NULL,
    rating INTEGER NOT NULL,
    created_at TEXT NOT NULL DEFAULT (datetime('now')),
    synced INTEGER NOT NULL DEFAULT 0
);

-- Cached calendar events
CREATE TABLE cached_events (
    id INTEGER NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    description TEXT,
    start_time TEXT NOT NULL,
    end_time TEXT,
    all_day INTEGER NOT NULL DEFAULT 0,
    event_type TEXT NOT NULL,
    source TEXT NOT NULL,
    subject TEXT,
    location TEXT,
    cached_at TEXT NOT NULL DEFAULT (datetime('now'))
);

-- Key-value app state
CREATE TABLE app_state (
    key TEXT NOT NULL PRIMARY KEY,
    value TEXT NOT NULL
);

-- Exercises queries
selectAllExercises:
SELECT * FROM cached_exercises ORDER BY id;

insertExercise:
INSERT OR REPLACE INTO cached_exercises(id, entity_id, question, exercise_type, difficulty, bloom_level, options_json, correct_answer, explanation)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllExercises:
DELETE FROM cached_exercises;

-- Pending answers queries
selectPendingAnswers:
SELECT * FROM pending_answers WHERE synced = 0 ORDER BY created_at;

insertPendingAnswer:
INSERT INTO pending_answers(exercise_id, user_answer, rating, created_at)
VALUES (?, ?, ?, datetime('now'));

markAnswerSynced:
UPDATE pending_answers SET synced = 1 WHERE id = ?;

deleteSyncedAnswers:
DELETE FROM pending_answers WHERE synced = 1;

-- Events queries
selectEvents:
SELECT * FROM cached_events WHERE start_time >= ? AND start_time <= ? ORDER BY start_time;

insertEvent:
INSERT OR REPLACE INTO cached_events(id, title, description, start_time, end_time, all_day, event_type, source, subject, location)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

deleteAllEvents:
DELETE FROM cached_events;

-- App state queries
getState:
SELECT value FROM app_state WHERE key = ?;

setState:
INSERT OR REPLACE INTO app_state(key, value) VALUES (?, ?);
