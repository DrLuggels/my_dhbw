# =============================================================================
# DHBW Study Automation System - Environment Configuration
# =============================================================================
# Kopiere diese Datei zu .env und fülle deine eigenen Werte ein
# Niemals .env in Git committen!

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_NAME=DHBW_Automation
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:5173
API_URL=http://localhost:5000

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=dhbw_automation
DB_USERNAME=dhbw_user
DB_PASSWORD=your_secure_password_here
DB_CONNECTION_STRING=Server=${DB_HOST};Port=${DB_PORT};Database=${DB_DATABASE};User=${DB_USERNAME};Password=${DB_PASSWORD};

# -----------------------------------------------------------------------------
# Redis Cache
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# MinIO / S3 Storage
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=dhbw-files

# -----------------------------------------------------------------------------
# RabbitMQ Message Queue
# -----------------------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_long
JWT_ISSUER=DHBWAutomation
JWT_AUDIENCE=DHBWAutomationUsers
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# -----------------------------------------------------------------------------
# AI Services - OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_GPT4=gpt-4-turbo-preview
OPENAI_MODEL_GPT35=gpt-3.5-turbo
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# -----------------------------------------------------------------------------
# AI Services - Anthropic Claude
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=4096

# -----------------------------------------------------------------------------
# AI Services - Google Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_MODEL=gemini-pro
GEMINI_VISION_MODEL=gemini-pro-vision

# -----------------------------------------------------------------------------
# AI Services - Deepgram (for Live Transcription)
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPGRAM_MODEL=nova-2

# -----------------------------------------------------------------------------
# Google Services (Calendar & Gmail)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
GOOGLE_CALENDAR_ID=primary

# -----------------------------------------------------------------------------
# Microsoft Services (Outlook Calendar)
# -----------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MICROSOFT_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/microsoft/callback

# -----------------------------------------------------------------------------
# DHBW Rapla (Stundenplan)
# -----------------------------------------------------------------------------
RAPLA_BASE_URL=https://rapla-ravensburg.dhbw.de/rapla
RAPLA_USER=Daurer
RAPLA_FILE=WDS125+1.+Sem
RAPLA_POLL_INTERVAL_MINUTES=60
RAPLA_SYNC_ENABLED=true

# -----------------------------------------------------------------------------
# Moodle Integration
# -----------------------------------------------------------------------------
MOODLE_BASE_URL=https://moodle.dhbw-ravensburg.de
MOODLE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MOODLE_USER_ID=12345
MOODLE_POLL_INTERVAL_MINUTES=1

# -----------------------------------------------------------------------------
# Mail Configuration - Study Account
# -----------------------------------------------------------------------------
MAIL_STUDY_ENABLED=true
MAIL_STUDY_EMAIL=studentXXXXXX@dhbw-ravensburg.de
MAIL_STUDY_PASSWORD=your_mail_password
MAIL_STUDY_IMAP_HOST=imap.dhbw-ravensburg.de
MAIL_STUDY_IMAP_PORT=993
MAIL_STUDY_SMTP_HOST=smtp.dhbw-ravensburg.de
MAIL_STUDY_SMTP_PORT=587
MAIL_STUDY_POLL_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# Mail Configuration - Private Account (Gmail)
# -----------------------------------------------------------------------------
MAIL_PRIVATE_ENABLED=true
MAIL_PRIVATE_EMAIL=your.private@gmail.com
MAIL_PRIVATE_PASSWORD=your_app_specific_password
MAIL_PRIVATE_IMAP_HOST=imap.gmail.com
MAIL_PRIVATE_IMAP_PORT=993
MAIL_PRIVATE_SMTP_HOST=smtp.gmail.com
MAIL_PRIVATE_SMTP_PORT=587
MAIL_PRIVATE_POLL_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# Mail Configuration - Work Account (Office 365)
# -----------------------------------------------------------------------------
MAIL_WORK_ENABLED=true
MAIL_WORK_EMAIL=your.name@dentsplysirona.com
MAIL_WORK_PASSWORD=your_work_password
MAIL_WORK_IMAP_HOST=outlook.office365.com
MAIL_WORK_IMAP_PORT=993
MAIL_WORK_SMTP_HOST=smtp.office365.com
MAIL_WORK_SMTP_PORT=587
MAIL_WORK_POLL_INTERVAL_MINUTES=5

# -----------------------------------------------------------------------------
# Notification Services
# -----------------------------------------------------------------------------
# Push Notifications (Web Push)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your.email@example.com

# SMS Notifications (optional - Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

# WhatsApp Business API (optional)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# -----------------------------------------------------------------------------
# Background Worker Settings
# -----------------------------------------------------------------------------
WORKER_MAIL_POLL_INTERVAL=5
WORKER_MOODLE_POLL_INTERVAL=1
WORKER_BACKUP_INTERVAL_HOURS=24
WORKER_REMINDER_CHECK_INTERVAL=15

# -----------------------------------------------------------------------------
# Live Lecture Mode Settings
# -----------------------------------------------------------------------------
LECTURE_MAX_DURATION_MINUTES=180
LECTURE_AUDIO_CHUNK_SIZE_MS=500
LECTURE_MIN_CONFIDENCE=0.7
LECTURE_ENABLE_SPEAKER_DETECTION=true

# -----------------------------------------------------------------------------
# Tutor Mode Settings
# -----------------------------------------------------------------------------
TUTOR_SESSION_TIMEOUT_MINUTES=60
TUTOR_SPACED_REPETITION_ENABLED=true
TUTOR_QUIZ_AUTO_GENERATION=true

# -----------------------------------------------------------------------------
# MCP Server Configuration
# -----------------------------------------------------------------------------
MCP_ENABLED=true
MCP_PORT=3000
MCP_HOST=localhost

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
LOG_LEVEL=Information
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
FEATURE_LIVE_LECTURE=true
FEATURE_TUTOR_MODE=true
FEATURE_AUTO_BACKUP=true
FEATURE_TTS_AUDIO=true
FEATURE_VIDEO_ANALYSIS=false

# -----------------------------------------------------------------------------
# Backup Configuration
# -----------------------------------------------------------------------------
BACKUP_ENABLED=true
BACKUP_LOCATION=/backups
BACKUP_RETENTION_DAYS=30
BACKUP_COMPRESSION=true

# -----------------------------------------------------------------------------
# Rate Limiting
# -----------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# -----------------------------------------------------------------------------
# CORS Settings
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH
CORS_ALLOWED_HEADERS=*

# -----------------------------------------------------------------------------
# Development Tools
# -----------------------------------------------------------------------------
SWAGGER_ENABLED=true
GRAPHQL_PLAYGROUND_ENABLED=true
