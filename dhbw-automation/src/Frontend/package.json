{
  "name": "dhbw-automation-frontend",
  "version": "0.3.0",
  "description": "DHBW Study Automation System - Frontend",
  "author": "Dr. Luggels",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:unit": "vitest --run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "pinia": "^2.1.7",
    "axios": "^1.6.5",
    "vuetify": "^3.5.0",
    "@mdi/font": "^7.4.47",
    "chart.js": "^4.4.1",
    "vue-chartjs": "^5.3.0",
    "dayjs": "^1.11.10",
    "socket.io-client": "^4.6.1",
    "pdfjs-dist": "^4.0.379",
    "marked": "^11.1.1",
    "dompurify": "^3.0.8",
    "vue-toastification": "^2.0.0-rc.5",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.5",
    "@types/dompurify": "^3.0.5",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vue/eslint-config-prettier": "^9.0.0",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/test-utils": "^2.4.3",
    "eslint": "^8.56.0",
    "eslint-plugin-vue": "^9.20.1",
    "jsdom": "^23.2.0",
    "prettier": "^3.2.4",
    "typescript": "~5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-pwa": "^0.17.4",
    "vitest": "^1.2.0",
    "vue-tsc": "^1.8.27",
    "@playwright/test": "^1.41.0",
    "sass": "^1.70.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
