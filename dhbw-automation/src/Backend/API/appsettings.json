{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "JavaDocsSync": {
    "Enabled": true,
    "SyncIntervalHours": 12,
    "SyncOnStartup": true,
    "StartupDelaySeconds": 30,
    "MaxEmbeddingsPerRun": 50,
    "EmbeddingDelayMs": 200,
    "WebhookEnabled": false,
    "WebhookSecret": null,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 60
  },
  "JavaDocs": {
    "LocalPath": "./data/java-docs-repo"
  }
}
